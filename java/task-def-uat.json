{
  "family": "property-search-service-uat",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::668857951936:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::668857951936:role/ecsSpringTaskRole",
  "containerDefinitions": [
    {
      "name": "property-search-service-uat",
      "image": "PLACEHOLDER_IMAGE",
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "uat"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-2"
        },
        {
          "name": "SPRING_DATASOURCE_DRIVER_CLASS_NAME",
          "value": "software.amazon.jdbc.Driver"
        },
        {
          "name": "SPRING_JPA_PROPERTIES_HIBERNATE_CONNECTION_URL",
          "value": "jdbc:aws-wrapper:postgresql://database-2.cluster-cnwoiaimcr95.us-east-2.rds.amazonaws.com:5432/postgres?ssl=true&sslmode=require&wrapperPlugins=iam"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "value": "iam-placeholder-auth"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:aws-wrapper:postgresql://database-2.cluster-cnwoiaimcr95.us-east-2.rds.amazonaws.com:5432/postgres?ssl=true&sslmode=require&wrapperPlugins=iam"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "postgres"
        },
        {
          "name": "SPRING_JPA_PROPERTIES_HIBERNATE_CONNECTION_DRIVER_CLASS",
          "value": "software.amazon.jdbc.Driver"
        },
        {
          "name": "SPRING_JPA_PROPERTIES_HIBERNATE_CONNECTION_USERNAME",
          "value": "postgres"
        },
        {
          "name": "SPRING_JPA_PROPERTIES_HIBERNATE_HBM2DDL_AUTO",
          "value": "update"
        },
        {
          "name": "SPRING_DATASOURCE_HIKARI_USERNAME",
          "value": "postgres"
        },
        {
          "name": "SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT",
          "value": "org.hibernate.dialect.PostgreSQLDialect"
        },
        {
          "name": "SPRING_DATA_REDIS_HOST",
          "value": "127.0.0.1"
        },
        {
          "name": "SPRING_DATA_REDIS_PORT",
          "value": "6379"
        },
        {
          "name": "MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS",
          "value": "always"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/property-search-service-uat",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "embedded-redis-test",
      "image": "redis:7-alpine",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 6379,
          "hostPort": 6379
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/property-search-service-uat",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "redis"
        }
      }
    }
  ]
}
